# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Your Discord Bot Token (required)
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Guild ID for role setup script (optional)
# Set this to your server ID when running setup_roles.py
SETUP_GUILD_ID=0

# The ID of your Support/Staff role (required)
# Right-click the role in Discord > Copy ID
SUPPORT_ROLE_ID=0

# The ID of the category where tickets will be created (required)
# Right-click the category in Discord > Copy ID
TICKET_CATEGORY_ID=123456789012345678

# The ID of the channel where ticket transcripts will be posted (optional)
# Set to 0 or leave empty to disable transcript logging
LOG_CHANNEL_ID=123456789012345678

# Image URLs for embed styling (optional)
THUMBNAIL_URL=https://example.com/thumbnail.png
BANNER_URL=https://example.com/banner.png
GIVEAWAY_BANNER_URL=https://cdn.discordapp.com/attachments/1552924354902368276/1554446993344962630/240_F_1152943162_a5DegmnMOa7ajMhkJNBGipNTRu9LP5lb.png

# Banner visibility settings for different message types (optional)
# Set to "true" to show banners, "false" to hide them for each type
BANNER_TICKET_CREATION=true
BANNER_PURCHASE_CREATION=true
BANNER_TICKET_CONTROLS=true
BANNER_PAYMENT_INFO=true
BANNER_RATING=true
BANNER_VOUCH=true
BANNER_CONFIG=true
BANNER_PANEL=true
BANNER_GENERAL=true

# Guild ID for faster command syncing (optional)
# Set this to your server ID for instant command updates during development
SYNC_GUILD_ID=0

# Payment Configuration
INR_QR_URL=https://example.com/inr_qr.png
LTC_QR_URL=https://example.com/ltc_qr.png
INR_WALLET_ADDRESS=your_inr_wallet_address
LTC_WALLET_ADDRESS=your_ltc_wallet_address

# Rating Channel Configuration
RATING_CHANNEL_ID=123456789012345678

# Vouch Channel Configuration
VOUCH_CHANNEL_ID=123456789012345678

# Invite Announcement Channel Configuration
INVITE_ANNOUNCEMENT_CHANNEL_ID=123456789012345678

# Store Channel Configuration (Optional - Can also be set via commands)
# CAPES_STORE_CHANNEL_ID=123456789012345678
# ACCOUNTS_STORE_CHANNEL_ID=123456789012345679
# NITRO_STORE_CHANNEL_ID=123456789012345680

# Web Interface Configuration (Local Only)
# Used for web_embed_builder.py - runs locally on your machine
FLASK_SECRET_KEY=your_secret_key_here
WEB_USERNAME=admin
WEB_PASSWORD=admin123

# Giveaway Banner Configuration
# Set this to "true" to always show banners in giveaway embeds
GIVEAWAY_ALWAYS_SHOW_BANNER=true

# Giveaway Claim Category Configuration
# Category ID where giveaway claim tickets are created (for vouch button in support tickets)
GIVEAWAY_CLAIM_CATEGORY_ID=123456789012345678

# Auto Role Configuration
# Role ID to automatically give to new members when they join
# Set to 0 to disable
AUTO_ROLE_ID=0

# Firebase Configuration (REQUIRED for Firestore database)
# Get these from Firebase Console > Project Settings > Service Accounts
# Download service account JSON and extract these values
